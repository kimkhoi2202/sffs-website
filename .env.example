# Smart Fella or Fart Smella — website environment variables
#
# The marketing + quiz site itself requires NO environment variables to build,
# run, or deploy. The variables below are ONLY for the SFFS Creator Studio
# TikTok integration (app/tiktok + app/api/tiktok/*).
#
# Put REAL values in .env.local (gitignored) for local dev, and in the Vercel
# project settings for production. NEVER commit real secrets here.
# Prefix any browser-exposed variable with NEXT_PUBLIC_ (none are needed here).

# --- TikTok Content Posting API (required for /tiktok) ---
# From the TikTok for Developers portal → your app → Credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Optional ---
# Override the OAuth redirect URI. Defaults to the production callback:
#   https://www.smartfellaorfartsmella.com/api/tiktok/callback
# Set this for local dev (e.g. http://localhost:3000/api/tiktok/callback) and
# register the SAME value in the TikTok portal.
# TIKTOK_REDIRECT_URI=

# Optional dedicated secret used to encrypt the stored TikTok session cookie.
# If unset, the encryption key is derived from TIKTOK_CLIENT_SECRET. Set any
# long random string (e.g. `openssl rand -hex 32`) to decouple token encryption
# from the client secret.
# TIKTOK_TOKEN_SECRET=

# --- Email lead capture ("get access" form) — AWS Lambda -> Aurora proxy ---
# Required for the /api/access-signup route. SERVER-SIDE ONLY — never prefix with
# NEXT_PUBLIC. The route POSTs validated leads to a small AWS Lambda (fronted by
# API Gateway) that inserts into Aurora (sffs.email_signups) via the RDS Data API.
# The ONLY secret this app holds is EMAIL_PROXY_SECRET (a random shared secret);
# NO AWS keys are used. Inserts happen in app/api/access-signup via
# lib/email-store.ts.
EMAIL_PROXY_URL=
EMAIL_PROXY_SECRET=

# --- PostHog product analytics (client + server capture) ---
# The PROJECT (public) key — safe to expose in the browser bundle. Used by
# posthog-js (client) AND posthog-node (server-side email_captured). Project 524578,
# US cloud. The client talks to the /ingest reverse proxy (next.config.ts rewrites)
# to dodge ad-blockers; NEXT_PUBLIC_POSTHOG_HOST is the PostHog APP host (ui_host)
# for "view in PostHog" links only.
#
# ⚠️ The phx_ PERSONAL API key (PostHog management / MCP) is SERVER-MANAGEMENT ONLY.
# It must NEVER live in this repo or any app env — not even non-public. It stays in
# the MCP client config. Do not add a POSTHOG_PERSONAL_API_KEY here.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# --- Merch store (/store) — Stripe Checkout + app-code unlock gate ---
# SERVER-SIDE ONLY unless noted. Missing STRIPE_SECRET_KEY must not crash the
# site — /api/store/checkout returns a clean 503 so previews can deploy
# without keys. Catalog lives in code (lib/store/products.ts), no DB.
#
# Stripe secret key (test or live) used to create Checkout Sessions.
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook endpoint (app/api/store/webhook),
# used to verify `stripe-signature` via stripe.webhooks.constructEvent.
STRIPE_WEBHOOK_SECRET=
# Shared HMAC secret used to sign/verify Smart Fella unlock codes issued by
# the app at the "smart fella" tier, and the short-lived checkout tokens
# minted after a successful unlock (lib/store/unlock.ts). Keep in sync with
# whatever the app team uses to mint codes.
SFFS_UNLOCK_SECRET=
# Public site origin used to build Stripe success/cancel redirect URLs
# (falls back to the request origin if unset). Safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=
