# ---------------------------------------------------------------------------
# Smart Fella or Fart Smella — website
#
# The AI video pipeline lives in its OWN separate repo (sffs-ai-video-pipeline).
# The entire video/ folder is intentionally EXCLUDED from this website repo —
# it holds renders, remotion node_modules, audio, and a live ElevenLabs key.
# ---------------------------------------------------------------------------

# Video pipeline — separate repo, never tracked here
/video/

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / build output
/.next/
/out/
/build/
/dist/

# Testing / coverage
/coverage/

# Vercel
/.vercel/

# TypeScript (regenerated by `next build`)
*.tsbuildinfo
next-env.d.ts

# Env files — NEVER commit real secrets. Only .env.example is tracked.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS / editor cruft
.DS_Store
*.pem
